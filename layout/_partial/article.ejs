<article class="post wrap">
  <header class="post-header"><a class="back-link" href="<%= url_for('/') %>#albums">返回相册</a>
  <h1><%= post.title || (page.path === '404.html' ? '页面未找到' : '未命名') %></h1>
  <div class="post-meta"><% if (post.date) { %><time datetime="<%= date_xml(post.date) %>"><%= date(post.date, 'YYYY年M月D日') %></time><% } %>
  <% if (post.tags && post.tags.length) { %><span><%= post.tags.toArray().map(tag => tag.name).join('、') %></span><% } %></div></header>
  <%- partial('post/photos', {post:post}) %>
  <div class="post-content"><%- post.content %></div>
  <%- partial('post/nav', {post:post}) %>
  <% if (is_post() && theme.gallery && theme.gallery.explore) { const explore = theme.gallery.explore; %>
  <aside class="author-explore" aria-labelledby="explore-title">
    <h2 id="explore-title"><%= explore.title %></h2><p><%= explore.description %></p>
    <div class="about-links"><% (explore.links || []).forEach(function(link) { %><a href="<%= link.url %>"><%= link.label %> ↗</a><% }); %></div>
  </aside>
  <% } %>
  <%- partial('third-party/comments') %>
</article>
