<% const media = gallery_media(post); %>
<% if (media.video) { %>
<div class="post-video"><video controls playsinline preload="metadata"<% if (media.cover) { %> poster="<%= url_for(media.cover.src) %>"<% } %>>
<source src="<%= url_for(media.video.src) %>" type="<%= /\.webm(?:[?#]|$)/i.test(media.video.src) ? 'video/webm' : /\.ogv(?:[?#]|$)/i.test(media.video.src) ? 'video/ogg' : 'video/mp4' %>">
<a href="<%= url_for(media.video.src) %>">下载视频</a></video></div>
<% } else if (media.images.length) { %>
<div class="post-gallery"><% media.images.forEach(function(photo, i) { %>
<figure><a class="photo-link image-surface" href="<%= url_for(photo.src) %>" data-lightbox aria-label="放大照片：<%= photo.alt %>">
<img src="<%= url_for(photo.src) %>" alt="<%= photo.alt %>" <%- i === 0 ? 'fetchpriority="high"' : 'loading="lazy"' %> decoding="async"<% if (photo.width && photo.height) { %> width="<%= photo.width %>" height="<%= photo.height %>"<% } %>></a></figure>
<% }); %></div>
<% } %>
