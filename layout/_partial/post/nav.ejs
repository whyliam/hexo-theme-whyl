<% if (post.prev || post.next) { %>
<nav class="post-navigation" aria-label="相邻相册">
<div><% if (post.prev) { %><a href="<%= url_for(post.prev.path) %>"><span>较新的记录</span><strong><%= post.prev.title || '未命名' %></strong></a><% } %></div>
<div><% if (post.next) { %><a href="<%= url_for(post.next.path) %>"><span>较早的记录</span><strong><%= post.next.title || '未命名' %></strong></a><% } %></div>
</nav>
<% } %>
