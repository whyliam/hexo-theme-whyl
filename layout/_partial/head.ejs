<!DOCTYPE html>
<html lang="<%= config.language || 'zh-CN' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <% const pageTitle = page.title || (is_archive() ? '归档' : page.category || page.tag || ''); %>
  <title><%= pageTitle ? pageTitle + ' | ' : '' %><%= config.title %></title>
  <meta name="description" content="<%= strip_html(page.description || page.excerpt || config.description || config.subtitle || '') %>">
  <meta property="og:title" content="<%= pageTitle || config.title %>">
  <meta property="og:type" content="<%= is_post() ? 'article' : 'website' %>">
  <meta property="og:url" content="<%= full_url_for(page.path || '') %>">
  <meta property="og:site_name" content="<%= config.title %>">
  <% const shareMedia = gallery_media(page); if (shareMedia.cover) { %>
  <meta property="og:image" content="<%= full_url_for(shareMedia.cover.src) %>">
  <% } %>
  <% ['google', 'baidu', 'qihu'].forEach(function(provider) { if (theme[provider + '_site_verification']) { %>
  <meta name="<%= provider === 'qihu' ? '360' : provider %>-site-verification" content="<%= theme[provider + '_site_verification'] %>">
  <% } }); %>
  <link rel="canonical" href="<%= full_url_for(page.path || '') %>">
  <% if (theme.favicon) { %><link rel="icon" href="<%= url_for(theme.favicon) %>"><% } %>
  <% if (theme.rss) { %><link rel="alternate" href="<%= url_for(theme.rss) %>" title="<%= config.title %>" type="application/atom+xml"><% } %>
  <% const assetVersion = encodeURIComponent(theme.version || 'dev'); %>
  <link rel="stylesheet" href="<%= url_for('css/gallery.css') %>?v=<%= assetVersion %>">
  <link rel="stylesheet" href="<%= url_for('css/glasswork.css') %>?v=<%= assetVersion %>">
</head>
