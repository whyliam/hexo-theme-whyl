<section class="archive wrap" aria-labelledby="archive-title"><header class="post-header"><h1 id="archive-title">归档</h1><p>沿着时间，回看走过的地方。</p></header>
<% let lastYear = ''; page.posts.each(function(post) { const year = date(post.date, 'YYYY'); if (year !== lastYear) { if (lastYear) { %></ul></section><% } lastYear = year; %>
<section class="archive-year"><h2><%= year %></h2><ul>
<% } %>
<li><a href="<%= url_for(post.path) %>"><time datetime="<%= date_xml(post.date) %>"><%= date(post.date, 'MM.DD') %></time><span><%= post.title || '未命名' %></span></a></li>
<% }); if (lastYear) { %></ul></section><% } else { %><p class="empty-state">还没有记录。</p><% } %>
<%- partial('pagination') %></section>
